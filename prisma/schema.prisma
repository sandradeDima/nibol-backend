  id                 String   @id @default(uuid()) @db.Char(36)
  workflowVersionId  String   @map("workflow_version_id") @db.Char(36)
  nodeKey            String   @map("node_key") @db.NVarChar(100)
  name               String   @db.NVarChar(191)
  description        String?  @db.NVarChar(Max)
  type               String   @db.NVarChar(64)
  assignmentStrategy String?  @map("assignment_strategy") @db.NVarChar(64)
  positionX          Float    @map("position_x")
  positionY          Float    @map("position_y")
  configurationJson  String   @map("configuration_json") @db.NVarChar(Max)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  version              WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceTransitions    WorkflowTransition[]    @relation("WorkflowTransitionSource")
  targetTransitions    WorkflowTransition[]    @relation("WorkflowTransitionTarget")
  currentInstances     WorkflowInstance[]      @relation("WorkflowInstanceCurrentNode")
  sourceTransitionLogs WorkflowTransitionLog[] @relation("WorkflowTransitionLogSource")
  targetTransitionLogs WorkflowTransitionLog[] @relation("WorkflowTransitionLogTarget")
  tasks                WorkflowTask[]

  @@unique([workflowVersionId, nodeKey])
  @@index([workflowVersionId, type])
  @@map("workflow_nodes")
}

model WorkflowTransition {
  id                String  @id @default(uuid()) @db.Char(36)
  workflowVersionId String  @map("workflow_version_id") @db.Char(36)
  sourceNodeId      String  @map("source_node_id") @db.Char(36)
  targetNodeId      String  @map("target_node_id") @db.Char(36)
  label             String? @db.NVarChar(191)
  priority          Int     @default(0)
  transitionType    String? @map("transition_type") @db.NVarChar(64)
  conditionGroupId  String? @map("condition_group_id") @db.Char(36)

  version        WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceNode     WorkflowNode            @relation("WorkflowTransitionSource", fields: [sourceNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetNode     WorkflowNode            @relation("WorkflowTransitionTarget", fields: [targetNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conditionGroup WorkflowConditionGroup? @relation(fields: [conditionGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflowVersionId, priority])
  @@index([sourceNodeId, priority])
  @@index([targetNodeId])
  @@index([conditionGroupId])
  @@map("workflow_transitions")
}

model WorkflowConditionGroup {
  id                String  @id @default(uuid()) @db.Char(36)
  workflowVersionId String  @map("workflow_version_id") @db.Char(36)
  logicOperator     String  @map("logic_operator") @db.NVarChar(64)
  description       String? @db.NVarChar(Max)

  version     WorkflowVersion      @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conditions  WorkflowCondition[]
  transitions WorkflowTransition[]

  @@index([workflowVersionId])
  @@map("workflow_condition_groups")
}

model WorkflowCondition {
  id               String  @id @default(uuid()) @db.Char(36)
  conditionGroupId String  @map("condition_group_id") @db.Char(36)
  field            String  @db.NVarChar(100)
  operator         String  @db.NVarChar(64)
  valueJson        String? @map("value_json") @db.NVarChar(Max)
  sequence         Int
  description      String? @db.NVarChar(Max)

  group WorkflowConditionGroup @relation(fields: [conditionGroupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conditionGroupId, sequence])
  @@index([conditionGroupId, sequence])
  @@map("workflow_conditions")
}

model WorkflowInstance {
  id                   String    @id @default(uuid()) @db.Char(36)
  workflowDefinitionId String    @map("workflow_definition_id") @db.Char(36)
  workflowVersionId    String    @map("workflow_version_id") @db.Char(36)
  processType          String    @map("process_type") @db.NVarChar(100)
  entityType           String    @map("entity_type") @db.NVarChar(100)
  entityId             String    @map("entity_id") @db.NVarChar(191)
  currentNodeId        String?   @map("current_node_id") @db.Char(36)
  status               String    @default("PENDING") @db.NVarChar(64)
  startedById          String    @map("started_by_id") @db.Char(36)
  startedAt            DateTime  @default(now()) @map("started_at")
  completedAt          DateTime? @map("completed_at")
  finalResult          String?   @map("final_result") @db.NVarChar(64)
  runtimeErrorCode     String?   @map("runtime_error_code") @db.NVarChar(100)
  runtimeErrorMessage  String?   @map("runtime_error_message") @db.NVarChar(Max)
  lastExecutionAt      DateTime? @map("last_execution_at")
  contextJson          String    @map("context_json") @db.NVarChar(Max)

  definition  WorkflowDefinition      @relation(fields: [workflowDefinitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version     WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentNode WorkflowNode?           @relation("WorkflowInstanceCurrentNode", fields: [currentNodeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  startedBy   User                    @relation("WorkflowInstanceStartedBy", fields: [startedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks       WorkflowTask[]
  transitions WorkflowTransitionLog[]
  timers      WorkflowTimer[]

  @@index([workflowDefinitionId, status])
  @@index([workflowVersionId, status])
  @@index([processType, status])
  @@index([entityType, entityId])
  @@index([currentNodeId, status])
  @@index([startedById])
  @@map("workflow_instances")
}

model WorkflowTask {
  id                     String    @id @default(uuid()) @db.Char(36)
  workflowInstanceId     String    @map("workflow_instance_id") @db.Char(36)
  nodeId                 String    @map("node_id") @db.Char(36)
  assignedUserId         String?   @map("assigned_user_id") @db.Char(36)
  assignedRoleId         String?   @map("assigned_role_id") @db.Char(36)
  assignedAreaId         String?   @map("assigned_area_id") @db.Char(36)
  status                 String    @default("PENDING") @db.NVarChar(64)
  entrySequence          Int       @default(1) @map("entry_sequence")
  dueAt                  DateTime? @map("due_at")
  completedAt            DateTime? @map("completed_at")
  decision               String?   @db.NVarChar(100)
  comments               String?   @db.NVarChar(Max)
  assignmentSnapshotJson String?   @map("assignment_snapshot_json") @db.NVarChar(Max)
  assignmentHistoryJson  String?   @map("assignment_history_json") @db.NVarChar(Max)
  evidenceReferencesJson String?   @map("evidence_references_json") @db.NVarChar(Max)
  createdAt              DateTime  @default(now()) @map("created_at")

  instance     WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  node         WorkflowNode     @relation(fields: [nodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedUser User?            @relation("WorkflowTaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedRole Role?            @relation("WorkflowTaskAssignedRole", fields: [assignedRoleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedArea Area?            @relation("WorkflowTaskAssignedArea", fields: [assignedAreaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  timers       WorkflowTimer[]

  @@unique([workflowInstanceId, nodeId, entrySequence], map: "workflow_tasks_instance_node_entry_key")
  @@index([assignedUserId, status, dueAt])
  @@index([assignedRoleId, status])
  @@index([assignedAreaId, status])
  @@index([workflowInstanceId, status])
  @@index([nodeId])
  @@index([status, dueAt])
  @@map("workflow_tasks")
}

model WorkflowTransitionLog {
  id                  String   @id @default(uuid()) @db.Char(36)
  workflowInstanceId  String   @map("workflow_instance_id") @db.Char(36)
  sourceNodeId        String?  @map("source_node_id") @db.Char(36)
  targetNodeId        String?  @map("target_node_id") @db.Char(36)
  triggerType         String   @map("trigger_type") @db.NVarChar(64)
  performedById       String?  @map("performed_by_id") @db.Char(36)
  decision            String?  @db.NVarChar(100)
  eventType           String?  @map("event_type") @db.NVarChar(64)
  detailsJson         String?  @map("details_json") @db.NVarChar(Max)
  contextSnapshotJson String   @map("context_snapshot_json") @db.NVarChar(Max)
  createdAt           DateTime @default(now()) @map("created_at")

  instance    WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceNode  WorkflowNode?    @relation("WorkflowTransitionLogSource", fields: [sourceNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetNode  WorkflowNode?    @relation("WorkflowTransitionLogTarget", fields: [targetNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedBy User?            @relation("WorkflowTransitionPerformedBy", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflowInstanceId, createdAt])
  @@index([sourceNodeId])
  @@index([targetNodeId])
  @@index([performedById])
  @@index([workflowInstanceId, eventType, createdAt], map: "workflow_transition_logs_workflow_instance_id_event_type_cre_idx")
  @@map("workflow_transition_logs")
}

model WorkflowTimer {
  id                 String    @id @default(uuid()) @db.Char(36)
  workflowInstanceId String    @map("workflow_instance_id") @db.Char(36)
  workflowTaskId     String?   @map("workflow_task_id") @db.Char(36)
  timerType          String    @map("timer_type") @db.NVarChar(64)
  executeAt          DateTime  @map("execute_at")
  status             String    @default("PENDING") @db.NVarChar(64)
  executedAt         DateTime? @map("executed_at")
  configurationJson  String    @map("configuration_json") @db.NVarChar(Max)
  attempts           Int       @default(0)
  lastError          String?   @map("last_error") @db.NVarChar(Max)
  lastAttemptAt      DateTime? @map("last_attempt_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  instance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task     WorkflowTask?    @relation(fields: [workflowTaskId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([workflowTaskId, timerType], where: raw("[workflow_task_id] IS NOT NULL"), map: "workflow_timers_task_type_key")
  @@index([status, executeAt])
  @@index([workflowInstanceId, status])
  @@index([workflowTaskId, status])
  @@map("workflow_timers")
}
