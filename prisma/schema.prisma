generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlserver"
}

model DeadlineExtensionClassification {
  id                String                     @id @default(uuid()) @db.Char(36)
  code              String                     @unique @db.NVarChar(64)
  name              String                     @unique @db.NVarChar(191)
  description       String                     @db.NVarChar(500)
  maxAdditionalDays Int                        @map("max_additional_days")
  active            Boolean                    @default(true)
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")
  requests          DeadlineExtensionRequest[]

  @@index([active])
  @@map("deadline_extension_classifications")
}

model User {
  id                                String                     @id @default(uuid()) @db.Char(36)
  name                              String                     @db.NVarChar(191)
  email                             String                     @unique @db.NVarChar(191)
  password                          String?                    @db.NVarChar(255)
  avatar                            String?                    @db.NVarChar(255)
  jobTitle                          String?                    @map("job_title") @db.NVarChar(191)
  isActive                          Boolean                    @default(true) @map("is_active")
  emailVerified                     Boolean                    @default(false) @map("email_verified")
  lastLoginAt                       DateTime?                  @map("last_login_at")
  createdAt                         DateTime                   @default(now()) @map("created_at")
  updatedAt                         DateTime                   @updatedAt @map("updated_at")
  deletedAt                         DateTime?                  @map("deleted_at")
  accounts                          Account[]
  sessions                          Session[]
  createdInvites                    Invitation[]               @relation("InvitationCreatedBy")
  userRoles                         UserRole[]
  notifications                     Notification[]
  activityLogs                      ActivityLog[]
  changedAuditLogs                  AuditLog[]                 @relation("AuditLogChangedBy")
  deletedObservations               Observation[]              @relation("ObservationDeletedBy")
  managedAreas                      Area[]                     @relation("AreaManager")
  auditedObservations               Observation[]              @relation("ObservationAuditor")
  createdAuditReports               AuditReport[]              @relation("AuditReportCreatedBy")
  processOwnedObservationAreas      ObservationArea[]          @relation("ObservationAreaProcessOwner")
  responsibleObservationAreas       ObservationArea[]          @relation("ObservationAreaResponsible")
  remediationPlanOwners             RemediationPlan[]          @relation("RemediationPlanOwner")
  createdRemediationPlans           RemediationPlan[]          @relation("RemediationPlanCreatedBy")
  approvedRemediationPlans          RemediationPlan[]          @relation("RemediationPlanApprovedBy")
  returnedRemediationPlans          RemediationPlan[]          @relation("RemediationPlanReturnedBy")
  deletedRemediationPlans           RemediationPlan[]          @relation("RemediationPlanDeletedBy")
  actionPlanAssignments             ActionPlan[]               @relation("ActionPlanResponsible")
  deletedActionPlans                ActionPlan[]               @relation("ActionPlanDeletedBy")
  submittedProgressEvaluations      ProgressEvaluation[]       @relation("ProgressEvaluationSubmittedBy")
  reviewedProgressEvaluations       ProgressEvaluation[]       @relation("ProgressEvaluationReviewedBy")
  uploadedEvidenceFiles             EvidenceFile[]             @relation("EvidenceUploadedBy")
  observationComments               ObservationComment[]       @relation("ObservationCommentAuthor")
  progressReviewHistoryItems        ProgressReviewHistory[]    @relation("ProgressReviewHistoryActor")
  requestedDeadlineExtensions       DeadlineExtensionRequest[] @relation("DeadlineExtensionRequestedBy")
  managerReviewedDeadlineExtensions DeadlineExtensionRequest[] @relation("DeadlineExtensionManagerReviewer")
  notificationDeliveries            NotificationDelivery[]     @relation("NotificationDeliveryRecipient")
  scheduledJobExecutions            ScheduledJobExecution[]    @relation("ScheduledJobExecutionTriggeredBy")
  entityActivities                  EntityActivity[]           @relation("EntityActivityActor")
  createdWorkflowDefinitions        WorkflowDefinition[]       @relation("WorkflowDefinitionCreatedBy")
  createdWorkflowVersions           WorkflowVersion[]          @relation("WorkflowVersionCreatedBy")
  publishedWorkflowVersions         WorkflowVersion[]          @relation("WorkflowVersionPublishedBy")
  startedWorkflowInstances          WorkflowInstance[]         @relation("WorkflowInstanceStartedBy")
  assignedWorkflowTasks             WorkflowTask[]             @relation("WorkflowTaskAssignedUser")
  performedWorkflowTransitions      WorkflowTransitionLog[]    @relation("WorkflowTransitionPerformedBy")

  @@index([deletedAt])
  @@map("users")
}

model Role {
  id                    String           @id @default(uuid()) @db.Char(36)
  code                  String           @unique @db.NVarChar(64)
  name                  String           @unique @db.NVarChar(191)
  description           String?          @db.NVarChar(255)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  deletedAt             DateTime?        @map("deleted_at")
  userRoles             UserRole[]
  rolePermissions       RolePermission[]
  invitations           Invitation[]
  assignedWorkflowTasks WorkflowTask[]   @relation("WorkflowTaskAssignedRole")

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique @db.NVarChar(191)
  description     String?          @db.NVarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  rolePermissions RolePermission[]

  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@unique([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Char(36)
  roleId       String     @map("role_id") @db.Char(36)
  permissionId String     @map("permission_id") @db.Char(36)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Char(36)
  email       String    @db.NVarChar(191)
  token       String    @unique @db.NVarChar(191)
  roleId      String    @map("role_id") @db.Char(36)
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdById String    @map("created_by") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  role        Role      @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User      @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([email])
  @@index([roleId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("invitations")
}

model Setting {
  id           String    @id @default(uuid()) @db.Char(36)
  appName      String    @map("app_name") @db.NVarChar(191)
  logo         String?   @db.NVarChar(255)
  primaryColor String?   @map("primary_color") @db.NVarChar(32)
  supportEmail String    @map("support_email") @db.NVarChar(191)
  timezone     String    @db.NVarChar(100)
  dateFormat   String    @map("date_format") @db.NVarChar(50)
  senderName   String    @map("sender_name") @db.NVarChar(191)
  senderEmail  String    @map("sender_email") @db.NVarChar(191)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("settings")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Char(36)
  userId     String                 @map("user_id") @db.Char(36)
  title      String                 @db.NVarChar(191)
  message    String                 @db.NVarChar(Max)
  type       String                 @default("info") @db.NVarChar(64)
  priority   String                 @default("NORMAL") @db.NVarChar(64)
  eventType  String?                @map("event_type") @db.NVarChar(100)
  entityType String?                @map("entity_type") @db.NVarChar(100)
  entityId   String?                @map("entity_id") @db.Char(36)
  targetUrl  String?                @map("target_url") @db.NVarChar(500)
  dedupeKey  String?                @map("dedupe_key") @db.NVarChar(255)
  isRead     Boolean                @default(false) @map("is_read")
  readAt     DateTime?              @map("read_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  deletedAt  DateTime?              @map("deleted_at")
  user       User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveries NotificationDelivery[]

  @@unique([dedupeKey], where: raw("[dedupe_key] IS NOT NULL"), map: "notifications_dedupe_key_key")
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([eventType, entityType, entityId])
  @@index([priority, createdAt])
  @@index([deletedAt])
  @@map("notifications")
}

model NotificationDelivery {
  id              String        @id @default(uuid()) @db.Char(36)
  notificationId  String?       @map("notification_id") @db.Char(36)
  dedupeKey       String?       @map("dedupe_key") @db.NVarChar(255)
  channel         String        @db.NVarChar(64)
  recipientUserId String?       @map("recipient_user_id") @db.Char(36)
  recipientEmail  String?       @map("recipient_email") @db.NVarChar(191)
  payloadJson     String?       @map("payload_json") @db.NVarChar(Max)
  status          String        @default("PENDING") @db.NVarChar(64)
  attempts        Int           @default(0)
  lastAttemptAt   DateTime?     @map("last_attempt_at")
  sentAt          DateTime?     @map("sent_at")
  errorMessage    String?       @map("error_message") @db.NVarChar(Max)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  notification    Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipientUser   User?         @relation("NotificationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([dedupeKey], where: raw("[dedupe_key] IS NOT NULL"), map: "notification_deliveries_dedupe_key_key")
  @@index([notificationId, channel])
  @@index([recipientUserId, channel, status])
  @@index([status, lastAttemptAt])
  @@map("notification_deliveries")
}

model EntityActivity {
  id                String       @id @default(uuid()) @db.Char(36)
  observationId     String?      @map("observation_id") @db.Char(36)
  entityType        String       @map("entity_type") @db.NVarChar(64)
  entityId          String       @map("entity_id") @db.NVarChar(191)
  activityType      String       @map("activity_type") @db.NVarChar(100)
  action            String       @db.NVarChar(100)
  actorUserId       String?      @map("actor_user_id") @db.Char(36)
  actorType         String       @default("USER") @map("actor_type") @db.NVarChar(32)
  title             String       @db.NVarChar(191)
  description       String?      @db.NVarChar(Max)
  previousDataJson  String?      @map("previous_data_json") @db.NVarChar(Max)
  newDataJson       String?      @map("new_data_json") @db.NVarChar(Max)
  metadataJson      String?      @map("metadata_json") @db.NVarChar(Max)
  visibility        String       @default("ALL_AUTHORIZED") @db.NVarChar(32)
  targetUrl         String?      @map("target_url") @db.NVarChar(500)
  dedupeKey         String?      @map("dedupe_key") @db.NVarChar(255)
  relatedAuditLogId String?      @map("related_audit_log_id") @db.Char(36)
  createdAt         DateTime     @default(now()) @map("created_at")
  observation       Observation? @relation(fields: [observationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actorUser         User?        @relation("EntityActivityActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([dedupeKey], where: raw("[dedupe_key] IS NOT NULL"), map: "entity_activities_dedupe_key_key")
  @@index([observationId])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([activityType])
  @@index([createdAt])
  @@index([visibility])
  @@map("entity_activities")
}

model ScheduledJobExecution {
  id                   String    @id @default(uuid()) @db.Char(36)
  jobName              String    @map("job_name") @db.NVarChar(100)
  runType              String?   @map("run_type") @db.NVarChar(16)
  cadenceKey           String?   @map("cadence_key") @db.NVarChar(32)
  periodKey            String?   @map("period_key") @db.NVarChar(16)
  dedupeKey            String?   @map("dedupe_key") @db.NVarChar(255)
  scheduledFor         DateTime? @map("scheduled_for")
  startedAt            DateTime  @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  status               String    @db.NVarChar(64)
  processedCount       Int       @default(0) @map("processed_count")
  notificationsCreated Int       @default(0) @map("notifications_created")
  emailsSent           Int       @default(0) @map("emails_sent")
  failuresCount        Int       @default(0) @map("failures_count")
  detailsJson          String?   @map("details_json") @db.NVarChar(Max)
  errorMessage         String?   @map("error_message") @db.NVarChar(Max)
  triggeredBy          String    @map("triggered_by") @db.NVarChar(64)
  triggeredByUserId    String?   @map("triggered_by_user_id") @db.Char(36)
  createdAt            DateTime  @default(now()) @map("created_at")
  triggeredByUser      User?     @relation("ScheduledJobExecutionTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([dedupeKey], where: raw("[dedupe_key] IS NOT NULL"), map: "scheduled_job_executions_dedupe_key_key")
  @@index([jobName, startedAt])
  @@index([jobName, status])
  @@index([jobName, cadenceKey, periodKey])
  @@index([triggeredByUserId])
  @@map("scheduled_job_executions")
}

model ScheduledJobLock {
  jobName    String   @id @map("job_name") @db.NVarChar(100)
  lockToken  String   @unique @map("lock_token") @db.Char(36)
  acquiredAt DateTime @map("acquired_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("scheduled_job_locks")
}

model ModuleRecord {
  id          String    @id @default(uuid()) @db.Char(36)
  moduleKey   String    @map("module_key") @db.NVarChar(100)
  name        String    @db.NVarChar(191)
  description String?   @db.NVarChar(Max)
  isActive    Boolean   @default(true) @map("is_active")
  metadata    String?   @db.NVarChar(Max)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([moduleKey, deletedAt])
  @@index([moduleKey, isActive])
  @@index([moduleKey, createdAt])
  @@map("module_records")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String   @db.NVarChar(191)
  entityType String   @map("entity_type") @db.NVarChar(191)
  entityId   String?  @map("entity_id") @db.Char(36)
  metadata   String?  @db.NVarChar(Max)
  ipAddress  String?  @map("ip_address") @db.NVarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  entityType  String   @map("entity_type") @db.NVarChar(191)
  entityId    String?  @map("entity_id") @db.Char(36)
  oldValues   String?  @map("old_values") @db.NVarChar(Max)
  newValues   String?  @map("new_values") @db.NVarChar(Max)
  changedById String?  @map("changed_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  changedBy   User?    @relation("AuditLogChangedBy", fields: [changedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([changedById])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RiskLevel {
  id                 String        @id @default(uuid()) @db.Char(36)
  name               String        @unique @db.NVarChar(100)
  key                String        @unique @db.NVarChar(100)
  description        String?       @db.NVarChar(500)
  colorToken         String?       @map("color_token") @db.NVarChar(64)
  severityOrder      Int           @map("severity_order")
  maxRemediationDays Int?          @map("max_remediation_days")
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")
  observations       Observation[]

  @@index([active, deletedAt])
  @@index([deletedAt])
  @@index([severityOrder])
  @@map("risk_levels")
}

model ObservationStatus {
  id              String        @id @default(uuid()) @db.Char(36)
  name            String        @db.NVarChar(100)
  key             String        @unique @db.NVarChar(100)
  description     String?       @db.NVarChar(500)
  sortOrder       Int           @map("sort_order")
  isInitial       Boolean       @default(false) @map("is_initial")
  isFinal         Boolean       @default(false) @map("is_final")
  countsAsOverdue Boolean       @default(false) @map("counts_as_overdue")
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  observations    Observation[]

  @@unique([name])
  @@index([active, deletedAt])
  @@index([deletedAt])
  @@index([sortOrder])
  @@map("observation_statuses")
}

model Area {
  id                    String            @id @default(uuid()) @db.Char(36)
  name                  String            @unique @db.NVarChar(191)
  code                  String?           @db.NVarChar(100)
  description           String?           @db.NVarChar(500)
  managerUserId         String?           @map("manager_user_id") @db.Char(36)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  deletedAt             DateTime?         @map("deleted_at")
  managerUser           User?             @relation("AreaManager", fields: [managerUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  observationAreas      ObservationArea[] @relation("ObservationAreaArea")
  remediationPlans      RemediationPlan[]
  assignedWorkflowTasks WorkflowTask[]    @relation("WorkflowTaskAssignedArea")

  @@unique([code], where: raw("[code] IS NOT NULL"), map: "areas_code_key")
  @@index([active, deletedAt])
  @@index([deletedAt])
  @@index([managerUserId])
  @@map("areas")
}

model AuditReport {
  id              String            @id @default(uuid()) @db.Char(36)
  reportNumber    String            @unique @map("report_number") @db.NVarChar(64)
  title           String            @db.NVarChar(191)
  reportDate      DateTime          @map("report_date") @db.Date
  reportClassId   String?           @map("report_class_id") @db.Char(36)
  createdByUserId String            @map("created_by_user_id") @db.Char(36)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")
  createdByUser   User              @relation("AuditReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportClass     AuditReportClass? @relation(fields: [reportClassId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  observations    Observation[]

  @@index([createdByUserId])
  @@index([reportDate])
  @@index([reportClassId])
  @@index([deletedAt])
  @@map("audit_reports")
}

model AuditReportClass {
  id          String        @id @default(uuid()) @db.Char(36)
  name        String        @unique @db.NVarChar(191)
  description String?       @db.NVarChar(500)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")
  reports     AuditReport[]

  @@index([active, deletedAt])
  @@index([deletedAt])
  @@map("audit_report_classes")
}

model ObservationDictionary {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String        @unique @db.NVarChar(191)
  description  String?       @db.NVarChar(Max)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  observations Observation[]

  @@index([isActive])
  @@map("observation_dictionary")
}

model Risk {
  id               String            @id @default(uuid()) @db.Char(36)
  name             String            @unique @db.NVarChar(191)
  description      String?           @db.NVarChar(Max)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  observationRisks ObservationRisk[]

  @@index([isActive])
  @@map("risks")
}

model SystemParameter {
  id          String    @id @default(uuid()) @db.Char(36)
  key         String    @unique @db.NVarChar(191)
  name        String    @db.NVarChar(191)
  value       String    @db.NVarChar(Max)
  valueType   String    @map("value_type") @db.NVarChar(32)
  group       String    @map("group_name") @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  editable    Boolean   @default(true)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([active, deletedAt])
  @@index([deletedAt])
  @@index([group, active, deletedAt])
  @@map("system_parameters")
}

model Catalog {
  id          String    @id @default(uuid()) @db.Char(36)
  type        String    @db.NVarChar(100)
  name        String    @db.NVarChar(191)
  key         String?   @db.NVarChar(100)
  description String?   @db.NVarChar(500)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([type, key], where: raw("[key] IS NOT NULL"), map: "catalogs_type_key_key")
  @@index([active, deletedAt])
  @@index([deletedAt])
  @@index([type, sortOrder])
  @@index([type, active, deletedAt])
  @@map("catalogs")
}

model Observation {
  id                        String                     @id @default(uuid()) @db.Char(36)
  auditReportId             String                     @map("audit_report_id") @db.Char(36)
  observationNumber         Int                        @map("observation_number")
  deletedObservationNumber  Int?                       @map("deleted_observation_number")
  mainObservationId         String                     @map("main_observation_id") @db.Char(36)
  title                     String                     @db.NVarChar(191)
  description               String                     @db.NVarChar(Max)
  auditRecommendation       String                     @map("audit_recommendation") @db.NVarChar(Max)
  riskLevelId               String                     @map("risk_level_id") @db.Char(36)
